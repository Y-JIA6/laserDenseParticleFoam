# ===== OpenFOAM simulation results =====

# Parallel decomposed directories
processor*/

# Numbered time directories (simulation output, e.g. 0.001/, 0.002/, 0.1/)
# Keep "0/" (initial conditions) but ignore all other numeric time dirs
00test/*/[1-9]*/
00test/*/0.[0-9]*/
00test/oldtest/*/[1-9]*/
00test/oldtest/*/0.[0-9]*/

# OpenFOAM log files
log.*

# Foam reconstruction / postProcessing output
postProcessing/
VTK/
sets/

# ===== Plot / analysis output =====
*.png
*.jpg
*.jpeg
*.gif
*.eps
*.pdf

# ===== Python cache =====
__pycache__/
*.pyc
*.pyo
*.pyd

# ===== Compiled solver binaries / objects =====
Make/linux*/
DPMTurbulenceModels/Make/linux*/
DPMTurbulenceModels/lnInclude/
DPMDyMFoam/Make/linux*/
MPPICFoam/Make/linux*/

# lnInclude symlink directories (generated by wmake)
lnInclude/

# ===== Backup directory =====
work_backup/

# ===== OS / editor artefacts =====
.DS_Store
Thumbs.db
*.swp
*.swo
*~
