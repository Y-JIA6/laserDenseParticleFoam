FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon.air;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 100.0;

boundaryField
{
    walls
    {
        type            epsilonWallFunction;
        value           uniform 100.0;
    }

    lowerInlet
    {
        type            fixedValue;
        value           uniform 400.0;
    }

    upperInlet
    {
        type            fixedValue;
        value           uniform 400.0;
    }

    outlet
    {
        type            inletOutlet;
        phi             phi.air;
        inletValue      uniform 100.0;
        value           uniform 100.0;
    }

    frontAndBack
    {
        type            symmetry;
    }
}


// ************************************************************************* //
