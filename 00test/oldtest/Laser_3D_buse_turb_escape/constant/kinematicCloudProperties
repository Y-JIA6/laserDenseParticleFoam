FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      kinematicCloudProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solution
{
    active          true;
    coupled         true;
    transient       yes;
    cellValueSourceCorrection on;

    interpolationSchemes
    {
        rho.air         cell;
        U.air           cellPoint;
        mu.air          cell;
        DUcDt           cellPoint;
    }

    averagingMethod basic;

    integrationSchemes
    {
        U               Euler;
    }

    sourceTerms
    {
        schemes
        {
            U semiImplicit 1;
        }
    }
}

constantProperties
{
    rho0            1000;

    alphaMax        0.9;
}

subModels
{
    particleForces
    {
        WenYuDrag
        {
            alphac alpha.air;
        }
        
        gravity;
        
        pressureGradient
        {
            U U.air;
        }
    }

    injectionModels
    {
        /*
            % matlab/octave calculation of flow rate
            alpha=0.1
            U=20
            A=0.01^2
            Q=U*A
            d=650e-6
            v=(4/3)*pi*(d/2)^3
            n=1
            rate=alpha*Q/(v*n)
        */

        model1
        {
            type            patchInjection;
            parcelBasisType fixed;
            patch           powderInlet;
            U0              (0 0 0);
            nParticle       1;
            parcelsPerSecond 23000;
            sizeDistribution
            {
                type            normal;
                normalDistribution
                {
                    mu              106e-6;
                    sigma           45e-6;
                    minValue        61e-6;
                    maxValue        156e-6;
                }
            }
            flowRateProfile constant 1;
            massTotal       0;
            SOI             0;
            duration        10;
        }

        
    }

    dispersionModel none;

    patchInteractionModel localInteraction;

    localInteractionCoeffs
    {
        patches
        (
            "(frontAndBack|walls)"
            {
                type rebound;
                e    1;
                mu   0;
            }
            "(powderInlet|gasInlet)"
            {
                type rebound;
                e    1;
                mu   0;
            }
            outlet
            {
                type escape;
//                type stick;
            }
        );
    }

    surfaceFilmModel none;

    packingModel none;

    collisionModel none;

    dampingModel relaxation;

    relaxationCoeffs
    {
        timeScaleModel
        {
            type nonEquilibrium;
            alphaPacked 0.58;
            e 0.9;
        }
    }

    isotropyModel stochastic;

    stochasticCoeffs
    {
        timeScaleModel
        {
            type isotropic;
            alphaPacked 0.58;
            e 0.9;
        }
    }

    stochasticCollisionModel none;
}

cloudFunctions
{}


